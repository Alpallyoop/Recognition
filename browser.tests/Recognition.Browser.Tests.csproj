<Project Sdk="Microsoft.NET.Sdk">

  <!-- Executes the browser's REAL governance code (GovernedActions), compiled from the very same
       source file the browser uses, against golden vectors and negative vectors. No WPF or WebView2
       dependency. Run with: dotnet run (project browser.tests, configuration Release).
       Token on success: SELFTEST_RECOGNITION_BROWSER_GOVERNED_ACTIONS_V1_OK -->

  <!-- NOTE: an XML comment may not contain two consecutive hyphens. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Recognition.Browser.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\browser\GovernedActions.cs" Link="GovernedActions.cs" />
    <Compile Include="..\browser\Appearance.cs" Link="Appearance.cs" />
    <Compile Include="..\browser\NetworkInfo.cs" Link="NetworkInfo.cs" />
    <Compile Include="..\browser\SetupSnapshot.cs" Link="SetupSnapshot.cs" />
    <Compile Include="..\browser\PasswordVault.cs" Link="PasswordVault.cs" />
    <Compile Include="..\browser\CardVault.cs" Link="CardVault.cs" />
    <Compile Include="..\browser\PrivacyRules.cs" Link="PrivacyRules.cs" />
    <Compile Include="..\browser\CodeHighlighter.cs" Link="CodeHighlighter.cs" />
    <Compile Include="..\browser\PdfTools.cs" Link="PdfTools.cs" />
    <Compile Include="..\browser\ImageMath.cs" Link="ImageMath.cs" />
    <Compile Include="..\browser\SafetyRules.cs" Link="SafetyRules.cs" />
    <Compile Include="..\browser\FilterEngine.cs" Link="FilterEngine.cs" />
    <Compile Include="..\browser\ImagePdf.cs" Link="ImagePdf.cs" />
    <Compile Include="..\browser\ExtensionGovernance.cs" Link="ExtensionGovernance.cs" />
    <Compile Include="..\browser\ExtensionDev.cs" Link="ExtensionDev.cs" />
    <Compile Include="..\browser\IntegrationReceipts.cs" Link="IntegrationReceipts.cs" />
    <Compile Include="..\browser\FirefoxThemes.cs" Link="FirefoxThemes.cs" />
    <Compile Include="..\browser\AnimatedImage.cs" Link="AnimatedImage.cs" />
    <Compile Include="..\browser\RuntimeCheck.cs" Link="RuntimeCheck.cs" />
    <Compile Include="..\browser\SoteriaBridge.cs" Link="SoteriaBridge.cs" />
    <Compile Include="..\browser\SoteriaPasswords.cs" Link="SoteriaPasswords.cs" />
    <Compile Include="..\browser\SoteriaBridgeProtocol.cs" Link="SoteriaBridgeProtocol.cs" />
    <Compile Include="..\browser\LaunchArgs.cs" Link="LaunchArgs.cs" />
    <Compile Include="..\browser\QrCode.cs" Link="QrCode.cs" />
    <Compile Include="..\browser\ProxyRules.cs" Link="ProxyRules.cs" />
    <Compile Include="..\browser\VpnDetect.cs" Link="VpnDetect.cs" />
    <Compile Include="..\browser\StartBackground.cs" Link="StartBackground.cs" />
    <Compile Include="..\browser\BrowserFeel.cs" Link="BrowserFeel.cs" />
    <Compile Include="..\browser\Workspace.cs" Link="Workspace.cs" />
    <Compile Include="..\browser\Customize.cs" Link="Customize.cs" />
    <Compile Include="..\browser\SelfUpdate.cs" Link="SelfUpdate.cs" />
    <Compile Include="..\browser\CloseGuard.cs" Link="CloseGuard.cs" />
    <Compile Include="..\browser\WeatherRadar.cs" Link="WeatherRadar.cs" />
    <Compile Include="..\browser\WeatherForecast.cs" Link="WeatherForecast.cs" />
    <Compile Include="..\browser\ThemeLibrary.cs" Link="ThemeLibrary.cs" />
    <Compile Include="..\browser\StartMotion.cs" Link="StartMotion.cs" />
    <!-- the same vendored runtime the browser embeds, so the test checks the embedded bytes' SHA-256 -->
    <EmbeddedResource Include="..\browser\shield\motion.js" LogicalName="motion.js" />
    <!-- Pinned. PDFsharp is MIT-licensed and has no native or Windows-only dependencies. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
