<Window x:Class="Recognition.Browser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Recognition.Browser"
        Title="Recognition — Governed Browser" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeWin}"
        Icon="recognition.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.New" Executed="NewTabCmd_Executed"/>
    <CommandBinding Command="{x:Static local:MainWindow.PrivateTab}" Executed="PrivateTabCmd_Executed"/>
  </Window.CommandBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- chrome -->
      <RowDefinition Height="*"/>      <!-- tabs + find + web content -->
      <RowDefinition Height="Auto"/>   <!-- status -->
    </Grid.RowDefinitions>

    <!-- Header picture of a Firefox theme (MainWindow.ThemeHeader.cs): behind the toolbar and the tab strip, never hit-tested -->
    <Grid x:Name="HeaderArt" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed"/>

    <!-- Chrome: nav + address + actions -->
    <Border x:Name="TopChrome" Grid.Row="0" Background="{DynamicResource ChromeTopBg}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,0,1">
      <Grid Margin="12,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>  <!-- back -->
          <ColumnDefinition Width="Auto"/>  <!-- forward -->
          <ColumnDefinition Width="Auto"/>  <!-- home -->
          <ColumnDefinition Width="Auto"/>  <!-- private -->
          <ColumnDefinition Width="Auto"/>  <!-- reload -->
          <ColumnDefinition Width="*"/>     <!-- address -->
          <ColumnDefinition Width="Auto"/>  <!-- go -->
          <ColumnDefinition Width="Auto"/>  <!-- new tab -->
          <ColumnDefinition Width="Auto"/>  <!-- menu -->
          <ColumnDefinition Width="Auto"/>  <!-- export -->
        </Grid.ColumnDefinitions>
        <Button x:Name="BackBtn"   Grid.Column="0" Content="&#xE72B;" ToolTip="Back (Alt+Left)"     Click="Back_Click"    Style="{StaticResource IconBtn}"/>
        <Button x:Name="FwdBtn"    Grid.Column="1" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click" Style="{StaticResource IconBtn}"/>
        <Button x:Name="HomeBtn"   Grid.Column="2" Content="&#xE80F;" ToolTip="Home (Alt+Home)"     Click="Home_Click"    Style="{StaticResource IconBtn}"/>
        <Button x:Name="PrivateBtn" Grid.Column="3" ToolTip="New private tab (Ctrl+Shift+N)" Click="MenuPrivateBtn_Click" Style="{StaticResource IconBtn}">
          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6.5,10 L8.7,4 Q9,3.3 9.8,3.3 H14.2 Q15,3.3 15.3,4 L17.5,10 Z M3,11.2 H21 V12.8 H3 Z"/>
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M4.5,17.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M13.5,17.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M10.5,17 Q12,15.8 13.5,17"/>
              </Canvas></Viewbox>
        </Button>
        <Button x:Name="ReloadBtn" Grid.Column="4" Content="&#xE72C;" ToolTip="Reload (Ctrl+R)"     Click="Reload_Click"  Style="{StaticResource IconBtn}"/>

        <Border x:Name="AddrBorder" Grid.Column="5" Background="{DynamicResource ChromeField}" BorderBrush="{DynamicResource ChromeLine2}" BorderThickness="1" CornerRadius="9" Margin="12,0" Height="38">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#6FCF97" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
            <TextBox x:Name="AddressBar" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource ChromeText}"
                     BorderThickness="0" VerticalContentAlignment="Center" Padding="8,7" CaretBrush="{DynamicResource ChromeText}"
                     FontSize="13" PreviewKeyDown="Address_PreviewKeyDown" KeyDown="Address_KeyDown" TextChanged="Address_TextChanged"
                     GotKeyboardFocus="Address_GotFocus" LostKeyboardFocus="Address_LostFocus"/>
            <Button x:Name="VpnBtn" Grid.Column="2" Content="&#xE774;" ToolTip="VPN: click for network settings" Foreground="{DynamicResource ChromeMuted}" Style="{StaticResource IconBtn}" Width="Auto" MinWidth="30" Height="30" FontSize="14" Click="Vpn_Click"/>
            <Button x:Name="ShieldBtn" Grid.Column="3" Content="&#xEA18;" ToolTip="Trackers and ads blocked: click for settings" Foreground="#6FCF97" Style="{StaticResource IconBtn}" Width="Auto" MinWidth="30" Height="30" FontSize="14" Click="Shield_Click"/>
            <Button x:Name="StarBtn" Grid.Column="4" Content="&#xE734;" ToolTip="Bookmark this page (Ctrl+D)" Style="{StaticResource IconBtn}" Width="30" Height="30" FontSize="14" Margin="2,0,4,0" Click="Star_Click" Visibility="Collapsed"/>
            <Button x:Name="KeyBtn" Grid.Column="5" ToolTip="Saved logins for this site" Visibility="Collapsed" Style="{StaticResource IconBtn}" Width="30" Height="30" Margin="2,0,4,0" Click="Key_Click">
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeLineJoin="Round" Data="M12,12 a4,4 0 1 0 -8,0 a4,4 0 1 0 8,0 M12,12 H22 M19,12 V16 M22,12 V15"/>
              </Canvas></Viewbox>
            </Button>
          </Grid>
        </Border>

        <Button x:Name="ExtBtn" Grid.Column="7" ToolTip="Extensions" Click="Extensions_Click" Style="{StaticResource IconBtn}">
          <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M4,9 H8.5 a2.5,2.5 0 1 1 5,0 H18 V13.5 a2.5,2.5 0 1 1 0,5 V21 H4 Z"/>
          </Canvas></Viewbox>
        </Button>
        <Button x:Name="GoBtn" Grid.Column="6" Content="&#xE751;" ToolTip="Go" Click="Go_Click" Style="{StaticResource IconBtn}" Visibility="Collapsed"/>
        <Button x:Name="NewTabBtn" Grid.Column="7" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" Style="{StaticResource IconBtn}" Visibility="Collapsed"/>
        <Button x:Name="MenuBtn" Grid.Column="8" Content="&#xE712;" ToolTip="Menu" Click="Menu_Click" Style="{StaticResource IconBtn}" Margin="2,0,6,0">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="New tab"          Click="MenuNewTab_Click"     InputGestureText="Ctrl+T"/>
              <MenuItem Header="New private tab"  Click="MenuNewPrivate_Click" InputGestureText="Ctrl+Shift+N"/>
              <MenuItem Header="Reopen closed tab" Click="MenuReopenTab_Click" InputGestureText="Ctrl+Shift+T"/>
              <MenuItem Header="Home"             Click="MenuHome_Click"       InputGestureText="Alt+Home"/>
              <MenuItem Header="Set home to current page" Click="MenuSetHome_Click"/>
              <Separator/>
              <MenuItem Header="Overview"  Click="MenuOverview_Click"/>
              <MenuItem Header="Bookmarks" Click="MenuBookmarks_Click"/>
              <MenuItem Header="History"   Click="MenuHistory_Click"/>
              <MenuItem Header="Downloads" Click="MenuDownloads_Click"/>
              <MenuItem Header="Bookmark options">
                <MenuItem Header="Show or hide bookmarks bar" Click="MenuBookmarksBar_Click" InputGestureText="Ctrl+Shift+B"/>
                <MenuItem Header="Import bookmarks..." Click="MenuImportBookmarks_Click"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Find in page" Click="MenuFind_Click"  InputGestureText="Ctrl+F"/>
              <MenuItem Header="Page tools">
                <MenuItem Header="Reader mode" Click="MenuReader_Click"/>
                <MenuItem Header="Picture-in-picture (video)" Click="MenuPip_Click"/>
                <MenuItem Header="Translate this page..." Click="MenuTranslate_Click"/>
                <MenuItem Header="Close split view" Click="MenuCloseSplit_Click"/>
                <Separator/>
                <MenuItem Header="Save page snapshot (.mhtml + evidence)" Click="MenuSnapshotPage_Click"/>
                <MenuItem Header="Print..."        Click="MenuPrint_Click"/>
                <MenuItem Header="Save page as PDF..." Click="MenuSavePdf_Click"/>
                <MenuItem Header="Screenshot..."   Click="MenuScreenshot_Click"/>
                <MenuItem Header="Full-page screenshot to PDF (A4 pages)..." Click="MenuFullPdfA4_Click"/>
                <MenuItem Header="Full-page screenshot to PDF (Letter pages)..." Click="MenuFullPdfLetter_Click"/>
                <MenuItem Header="Full-page screenshot to PDF (one long page)..." Click="MenuFullPdfSingle_Click"/>
                <MenuItem Header="Full-page screenshot (PNG)..." Click="MenuFullPng_Click"/>
                <MenuItem Header="Use the PDF in this tab in PDF page tools" Click="MenuPdfFromTab_Click"/>
                <MenuItem Header="Edit this page (on/off)" Click="MenuEditPage_Click"/>
                <MenuItem Header="View source (highlighted)" Click="MenuViewSource_Click"/>
                <Separator/>
                <MenuItem Header="Open file (PDF, image, code)..." Click="MenuOpenFile_Click"/>
                <MenuItem Header="File tools (PDF and image)" Click="MenuTools_Click"/>
              </MenuItem>
              <MenuItem Header="Zoom">
                <MenuItem Header="Zoom in"    Click="MenuZoomIn_Click"  InputGestureText="Ctrl++"/>
                <MenuItem Header="Zoom out"   Click="MenuZoomOut_Click" InputGestureText="Ctrl+-"/>
                <MenuItem Header="Reset zoom" Click="MenuZoomReset_Click" InputGestureText="Ctrl+0"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="Privacy and security">
                <MenuItem Header="Shield (ads, trackers, fingerprinting)" Click="MenuShield_Click"/>
                <MenuItem Header="Passwords" Click="MenuPasswords_Click"/>
                <MenuItem Header="Passkeys" Click="MenuPasskeys_Click"/>
                <MenuItem Header="VPN / proxy" Click="Vpn_Click"/>
                <MenuItem Header="Network"   Click="MenuNetwork_Click"/>
                <MenuItem Header="SoteriaVault link" Click="MenuSoteria_Click"/>
              </MenuItem>
              <MenuItem Header="Extensions" Click="MenuExtensions_Click"/>
              <MenuItem Header="Customize (themes, colours, backgrounds)" Click="MenuCustomize_Click"/>
              <MenuItem Header="Tools (PDF, images)" Click="MenuTools_Click"/>
              <MenuItem Header="Setup snapshot" Click="MenuSetup_Click"/>
              <Separator/>
              <MenuItem Header="Settings"  Click="MenuSettings_Click"/>
              <MenuItem Header="Export Session (governed packet)" Click="Export_Click"/>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="ExportBtn" Grid.Column="9" Content="Export Session" ToolTip="Export a governed evidence packet"
                Click="Export_Click" Style="{StaticResource AccentBtn}" Height="34" Margin="0"/>
      </Grid>
    </Border>

    <!-- Tab strip + find bar over a persistent web host -->
    <DockPanel Grid.Row="1" LastChildFill="True">
      <Border x:Name="SideBar" DockPanel.Dock="Left" Width="54" Background="{DynamicResource ChromeSide}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" ToolTip="New private tab (Ctrl+Shift+N)" Click="MenuPrivateBtn_Click"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M6.5,10 L8.7,4 Q9,3.3 9.8,3.3 H14.2 Q15,3.3 15.3,4 L17.5,10 Z M3,11.2 H21 V12.8 H3 Z"/>
                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" Data="M4.5,17.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M13.5,17.5 a3,3 0 1 0 6,0 a3,3 0 1 0 -6,0 M10.5,17 Q12,15.8 13.5,17"/>
              </Canvas></Viewbox></Button>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE80F;" ToolTip="Home" Click="MenuHome_Click"/>
            <Border Height="1" Margin="9,6" Background="{DynamicResource ChromeLine}"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE9D9;" ToolTip="Overview: stats, cookies, trackers" Click="MenuOverview_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE734;" ToolTip="Bookmarks" Click="MenuBookmarks_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE81C;" ToolTip="History" Click="MenuHistory_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE896;" ToolTip="Downloads" Click="MenuDownloads_Click"/>
            <Border Height="1" Margin="9,6" Background="{DynamicResource ChromeLine}"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xEA18;" ToolTip="Shield (ads, trackers, fingerprinting)" Click="MenuShield_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE72E;" ToolTip="Passwords" Click="MenuPasswords_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE774;" ToolTip="VPN / proxy" Click="Vpn_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE90F;" ToolTip="Tools (PDF, images, page tools)" Click="MenuTools_Click"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE790;" ToolTip="Customize: themes, colours, backgrounds" Click="MenuCustomize_Click"/>
            <Button Style="{StaticResource IconBtn}" Margin="7,3" Content="&#xE713;" ToolTip="Settings" Click="MenuSettings_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <TabControl x:Name="Tabs" DockPanel.Dock="Top" Background="{DynamicResource ChromeTabStrip}" BorderThickness="0"
                  SelectionChanged="Tabs_SelectionChanged">
        <TabControl.Template>
          <ControlTemplate TargetType="TabControl">
            <ControlTemplate.Resources><local:MinusConverter x:Key="Minus"/></ControlTemplate.Resources>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="{DynamicResource ChromeTabStrip}">
              <!-- tabs, then a "+" right after the last tab (like every mainstream browser) -->
              <StackPanel Orientation="Horizontal" Margin="8,8,8,0">
                <local:TabShrinkPanel IsItemsHost="True" HorizontalAlignment="Left"
                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource Minus}, ConverterParameter=80}"/>
                <Button Command="ApplicationCommands.New" Content="&#xE710;" ToolTip="New tab (Ctrl+T)" Style="{StaticResource IconBtn}" Width="28" Height="28" FontSize="12" Margin="14,2,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </ScrollViewer>
          </ControlTemplate>
        </TabControl.Template>
      </TabControl>

      <Border x:Name="BookmarksBar" DockPanel.Dock="Top" Background="{DynamicResource ChromeBar}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,0,0,1" Height="38">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <StackPanel x:Name="BookmarksBarItems" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"/>
        </ScrollViewer>
      </Border>

      <Border x:Name="FindBar" DockPanel.Dock="Top" Background="{DynamicResource ChromeBar}" BorderBrush="{DynamicResource ChromeLine}"
              BorderThickness="0,0,0,1" Visibility="Collapsed" Padding="8,5">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Find:" Foreground="{DynamicResource ChromeMuted}" VerticalAlignment="Center" Margin="2,0,8,0" FontSize="12"/>
          <Border Background="{DynamicResource ChromeField}" BorderBrush="{DynamicResource ChromeLine2}" BorderThickness="1" CornerRadius="6" Width="280">
            <TextBox x:Name="FindBox" Background="Transparent" Foreground="{DynamicResource ChromeText}" BorderThickness="0"
                     VerticalContentAlignment="Center" Padding="8,5" CaretBrush="{DynamicResource ChromeText}" FontSize="12"
                     KeyDown="FindBox_KeyDown"/>
          </Border>
          <Button Content="&#x25B2;" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click" Style="{StaticResource NavBtn}" Margin="6,0,0,0"/>
          <Button Content="&#x25BC;" ToolTip="Next (Enter)"           Click="FindNext_Click" Style="{StaticResource NavBtn}"/>
          <Button Content="&#x2715;" ToolTip="Close (Esc)"            Click="FindClose_Click" Style="{StaticResource NavBtn}" Margin="6,0,0,0"/>
        </StackPanel>
      </Border>

      <Grid x:Name="WebHost" Background="#1E1F22">
        <Grid x:Name="LoadingCover" Grid.ColumnSpan="3" Panel.ZIndex="20" Background="{DynamicResource ChromeWin}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="LoadingText" Text="Unpacking files..." FontSize="15" Foreground="{DynamicResource ChromeText}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock x:Name="LoadingCount" Text="" FontSize="12" Foreground="{DynamicResource ChromeMuted}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <ProgressBar IsIndeterminate="True" Height="3" Width="180" BorderThickness="0" Background="{DynamicResource ChromeHover}" Foreground="{DynamicResource ChromeAccent}"/>
          </StackPanel>
        </Grid>
        <GridSplitter x:Name="SplitBar" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource ChromeLine}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Visibility="Collapsed" Panel.ZIndex="5"/>
      </Grid>
    </DockPanel>

    <!-- Status strip -->
    <Border Grid.Row="2" Background="{DynamicResource ChromeBar}" BorderBrush="{DynamicResource ChromeLine}" BorderThickness="0,1,0,0">
      <Grid Margin="10,4">
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource ChromeMuted}" FontSize="12" Text="starting…" HorizontalAlignment="Left"/>
        <TextBlock x:Name="GovText" Foreground="#6FCF97" FontSize="12" HorizontalAlignment="Right"
                   Text="governed • HTTPS-first • no autofill • no telemetry"/>
      </Grid>
    </Border>

    <!-- Omnibox suggestions (floats; not part of grid flow) -->
    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddrBorder}" Placement="Bottom"
           AllowsTransparency="True" StaysOpen="False" Focusable="False"
           HorizontalOffset="0" VerticalOffset="2">
      <Border Background="{DynamicResource ChromeMenuBg}" BorderBrush="{DynamicResource ChromeLine2}" BorderThickness="1" CornerRadius="8"
              MinWidth="{Binding ActualWidth, ElementName=AddrBorder}" Padding="4">
        <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0" MaxHeight="320"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="Suggest_Click">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,6"/>
              <Setter Property="Foreground" Value="#E4E7EC"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#26456E"/></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#20242C"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" Foreground="{DynamicResource ChromeMuted}" Width="20" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="{Binding Primary}" Foreground="{DynamicResource ChromeText}" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="820"/>
                  <TextBlock Text="{Binding Secondary}" Foreground="{DynamicResource ChromeMuted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="820"/>
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Popup>

  </Grid>
</Window>
